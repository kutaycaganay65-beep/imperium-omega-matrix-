                payBtn: "Lemon Squeezy ile Öde (IBAN'a Aktar)"
            },
            en: {
                pageTitle: "Imperium Omega - Autonomous Revenue & Athlete Matrix",
                mod1Title: "Autonomous CSV Data Cleaner",
                mod1Desc: "Upload raw data; let's trim spaces and remove duplicates.",
                dropText: "Drop your CSV file here",
                processBtn: "Optimize Data ⚡",
                mod2Title: "Autopilot Athlete & Coaching Generator",
                mod2Desc: "Generate Swimming (50m sprint), Boxing/MMA and Fitness programs.",
                lblDiscipline: "Discipline",
                lblGoal: "Goal / Focus",
                genPlanBtn: "Generate Pro Plan 🚀",
                previewTitle: "System Output & Preview Panel",
                waiting: "Waiting...",
                freeNotice: "Autopilot revenue engine active ($Cd = 0.0).",
                downloadBtn: "📥 Download / Unlock",
                modalTitle: "Imperium Lifetime Access",
                modalDesc: "Lifetime access to all autonomous tools, unlimited exports and pro athlete programs.",
                payBtn: "Secure Pay with Lemon Squeezy"
            },
            zh: {
                pageTitle: "Imperium Omega - 自主收入与运动员矩阵",
                mod1Title: "自主 CSV 数据清理器",
                mod1Desc: "上传原始数据；清理空格并去除重复项。",
                dropText: "将 CSV 文件拖放到此处",
                processBtn: "优化数据 ⚡",
                mod2Title: "自动驾驶运动员与教练生成器",
                mod2Desc: "生成游泳（50米冲刺）、拳击/MMA和健身计划。",
                lblDiscipline: "学科选择",
                lblGoal: "目标",
                genPlanBtn: "生成专业计划 🚀",
                previewTitle: "系统输出与预览面板",
                waiting: "等待中...",
                freeNotice: "自动驾驶收入引擎激活 ($Cd = 0.0)。",
                downloadBtn: "📥 下载 / 解锁",
                modalTitle: "Imperium 终身访问权限",
                modalDesc: "终身访问所有自主工具、无限导出和专业运动员计划。",
                payBtn: "通过 Lemon Squeezy 安全支付"
            },
            de: {
                pageTitle: "Imperium Omega - Autonomes Einnahmen- & Athletenmatrix",
                mod1Title: "Autonomer CSV-Datenreiniger",
                mod1Desc: "Rohdaten hochladen; Leerzeichen bereinigen und Duplikate entfernen.",
                dropText: "CSV-Datei hier ablegen",
                processBtn: "Daten optimieren ⚡",
                mod2Title: "Autopilot Athleten- & Coaching-Generator",
                mod2Desc: "Erstelle Schwimm-, Box- und Fitnessprogramme.",
                lblDiscipline: "Disziplin",
                lblGoal: "Ziel",
                genPlanBtn: "Profi-Plan generieren 🚀",
                previewTitle: "Systemausgabe & Vorschau",
                waiting: "Wartet...",
                freeNotice: "Einnahmen-Engine aktiv ($Cd = 0.0).",
                downloadBtn: "📥 Herunterladen / Freischalten",
                modalTitle: "Imperium Lebenslanger Zugriff",
                modalDesc: "Lebenslanger Zugriff auf alle autonomen Tools und Athletenpläne.",
                payBtn: "Sicher bezahlen mit Lemon Squeezy"
            },
            es: {
                pageTitle: "Imperium Omega - Matriz Autónoma de Ingresos y Atletas",
                mod1Title: "Limpiador Autónomo de Datos CSV",
                mod1Desc: "Sube datos sin procesar; limpia espacios y duplicados.",
                dropText: "Suelta tu archivo CSV aquí",
                processBtn: "Optimizar Datos ⚡",
                mod2Title: "Generador Autopiloto de Atletas",
                mod2Desc: "Genera programas de natación, boxeo y fitness.",
                lblDiscipline: "Disciplina",
                lblGoal: "Objetivo",
                genPlanBtn: "Generar Plan Pro 🚀",
                previewTitle: "Panel de Vista Previa",
                waiting: "Esperando...",
                freeNotice: "Motor de ingresos activo ($Cd = 0.0).",
                downloadBtn: "📥 Descargar / Desbloquear",
                modalTitle: "Acceso Vitalicio Imperium",
                modalDesc: "Acceso de por vida a todas las herramientas autónomas y programas.",
                payBtn: "Pago seguro con Lemon Squeezy"
            }
        };

        let currentLang = 'tr';
        function changeLanguage(lang) {
            currentLang = lang;
            const t = translations[lang];
            document.getElementById('pageTitle').innerText = t.pageTitle;
            document.getElementById('mod1Title').innerText = t.mod1Title;
            document.getElementById('mod1Desc').innerText = t.mod1Desc;
            document.getElementById('dropText').innerText = t.dropText;
            document.getElementById('processBtn').innerText = t.processBtn;
            document.getElementById('mod2Title').innerText = t.mod2Title;
            document.getElementById('mod2Desc').innerText = t.mod2Desc;
            document.getElementById('lblDiscipline').innerText = t.lblDiscipline;
            document.getElementById('lblGoal').innerText = t.lblGoal;
            document.getElementById('genPlanBtn').innerText = t.genPlanBtn;
            document.getElementById('previewTitle').innerText = t.previewTitle;
            document.getElementById('freeNotice').innerText = t.freeNotice;
            document.getElementById('downloadBtn').innerText = t.downloadBtn;
            document.getElementById('modalTitle').innerText = t.modalTitle;
            document.getElementById('modalDesc').innerText = t.modalDesc;
            document.getElementById('payBtn').innerText = t.payBtn;
        }

        function switchTab(tab) {
            if(tab === 'data') {
                document.getElementById('moduleData').classList.remove('hidden');
                document.getElementById('moduleAthlete').classList.add('hidden');
                document.getElementById('tabData').className = "flex-1 py-2 text-xs font-semibold rounded-lg bg-cyan-500 text-slate-950 transition";
                document.getElementById('tabAthlete').className = "flex-1 py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition";
            } else {
                document.getElementById('moduleData').classList.add('hidden');
                document.getElementById('moduleAthlete').classList.remove('hidden');
                document.getElementById('tabAthlete').className = "flex-1 py-2 text-xs font-semibold rounded-lg bg-cyan-500 text-slate-950 transition";
                document.getElementById('tabData').className = "flex-1 py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition";
            }
        }

        let parsedData = [];
        let isProUnlocked = false;

        document.getElementById('fileInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            Papa.parse(file, {
                header: true,
                skipEmptyLines: true,
                complete: function(results) {
                    parsedData = results.data;
                    document.getElementById('rowCountBadge').innerText = `${parsedData.length} Satır Yüklendi`;
                    renderTable(parsedData.slice(0, 3));
                }
            });
        });

        function processData() {
            if (parsedData.length === 0) { alert("Lütfen önce CSV yükleyin."); return; }
            parsedData = parsedData.map(row => {
                let r = {};
                for(let k in row) r[k] = typeof row[k] === 'string' ? row[k].trim() : row[k];
                return r;
            });
            document.getElementById('rowCountBadge').innerText = `${parsedData.length} Satır (Optimize Edildi)`;
            renderTable(isProUnlocked ? parsedData : parsedData.slice(0, 3));
            alert("Veriler 4444 matris standartlarında temizlendi!");
        }

        function generateAthletePlan() {
            const disc = document.getElementById('athleteDiscipline').value;
            const goal = document.getElementById('athleteGoal').value;
            
            let planText = "";
            if(disc === 'swimming') {
                planText = "🌊 **50m Sprint Yüzme Antrenman Programı (Özel Kelebek/Serbest):**\n\n" +
                           "1. Isınma: 400m serbest + 200m dril (tek kol kelebek)\n" +
                           "2. Patlayıcı Çıkış: 8 x 15m maksimum efor çıkış ve su altı akıntısı\n" +
                           "3. Ana Set (Hız): 6 x 50m serbest sprint (30sn dinlenme)\n" +
                           "4. Beslenme Desteği: Whey Protein + Kreatin + Laktozsuz Süt\n" +
                           "5. Dinlenme & CNS Yenilenme: 24 saat aktif toparlanma.";
            } else if(disc === 'boxing') {
                planText = "🥊 **Boks & MMA Patlayıcı Kuvvet ve Gölge Boksu Programı:**\n\n" +
                           "1. Isınma: 10 dk ip atlama + dinamik omuz rotasyonları\n" +
                           "2. Gölge Boksu: 5 raunt x 3 dk (Biyomekanik rotasyon ve güç aktarımı odaklı)\n" +
                           "3. Torba / Kuvvet: 4 x 3 dk ağırlık/direnç entegreli kombine vuruş\n" +
                           "4. Beslenme: Multivitamin + Bisküvi aromalı protein tozu + hidrasyon.";
            } else {
                planText = "💪 **Vücut Geliştirme & Atletik Fitness Programı:**\n\n" +
                           "1. Bileşik Hareketler: Squat / Bench Press / Deadlift (4 x 6-8 tekrar)\n" +
                           "2. Hipertrofi Odaklı İzolasyon: Süpersetler\n" +
                           "3. Protein Yapısı: Çikolata aromalı whey protein, temiz karbonhidrat.\n" +
                           "4. Dinlenme: Kaliteli uyku ve sıfır stres ($Cd = 0.0$).";
            }

            document.getElementById('tableContainer').innerHTML = `<div class="text-xs text-slate-200 whitespace-pre-line leading-relaxed">${planText}</div>`;
            document.getElementById('rowCountBadge').innerText = "Program Aktif";
        }

        function renderTable(data) {
            if (data.length === 0) return;
            const keys = Object.keys(data[0]);
            let html = '<table class="w-auto text-left text-xs text-slate-300 border-collapse"><thead class="bg-slate-900 text-slate-400 uppercase border-b border-slate-800"><tr>';
            keys.forEach(k => html += `<th class="px-3 py-2">${k}</th>`);
            html += '</tr></thead><tbody>';
            data.forEach(row => {
                html += '<tr class="border-b border-slate-800/40">';
                keys.forEach(k => html += `<td class="px-3 py-2">${row[k] || ''}</td>`);
                html += '</tr>';
            });
            html += '</tbody></table>';
            document.getElementById('tableContainer').innerHTML = html;
        }

        function exportData() {
            if (!isProUnlocked) {
                document.getElementById('paywallModal').classList.remove('hidden');
                return;
            }
            let csv = Papa.unparse(parsedData);
            let blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            let url = URL.createObjectURL(blob);
            let a = document.createElement('a');
            a.href = url; a.download = 'imperium_clean_data.csv'; a.click();
        }

        function closeModal() { document.getElementById('paywallModal').classList.add('hidden'); }
        function simulateSuccessfulPayment() {
            isProUnlocked = true;
            closeModal();
            alert("Ödeme Onaylandı! Sınırsız İndirme Kilidi Açıldı. Para IBAN'ınıza yönlendiriliyor.");
            renderTable(parsedData);
        }
    </script>
</body>
</html>
